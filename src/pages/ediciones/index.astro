---
import Base from '../../layouts/Base.astro';
import { edicionesPublicadas } from '../../lib/ediciones.ts';
import { ciudadActual } from '../../../ciudades/index.ts';
import { longDate } from '../../../pipeline/lib/fechas.ts';

const ciudad = ciudadActual();
const ediciones = await edicionesPublicadas();
---

<Base
  title={`Ediciones · ${ciudad.brand.name}`}
  description={`Archivo de ediciones de ${ciudad.brand.name}.`}
>
  <h1>Ediciones</h1>
  <p class="meta">Todas las ediciones publicadas, de la más reciente a la más antigua.</p>

  {ediciones.length === 0 ? (
    <p class="aviso">Todavía no hay ninguna edición publicada.</p>
  ) : (
    <ul class="lista-ediciones">
      {ediciones.map((edicion) => (
        <li>
          <a href={`/ediciones/${edicion.data.fecha}/`}>{longDate(edicion.data.fecha)}</a>
          <span>Edición nº {edicion.data.numero}</span>
        </li>
      ))}
    </ul>
  )}
</Base>
