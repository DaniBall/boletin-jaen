---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AccionesEdicion from '../components/AccionesEdicion.astro';
import { ultimaEdicion } from '../lib/ediciones.ts';
import { brand } from '../../pipeline/config.ts';
import { longDate } from '../../pipeline/lib/fechas.ts';
import { editionUrl } from '../../pipeline/lib/edicion.ts';
import { renderWhatsapp } from '../../pipeline/render/whatsapp.ts';

const edicion = await ultimaEdicion();
const contenido = edicion ? await render(edicion) : undefined;
const texto = edicion
  ? renderWhatsapp(edicion.body ?? '', { editionUrl: editionUrl(edicion.data.fecha) })
  : '';
const archivo = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/ediciones/`;
---

<Base title={`${brand.longName} · ${brand.tagline}`}>
  <h1>{brand.tagline}</h1>
  <p class="meta">
    De lunes a viernes, lo que te cambia el día en Jaén capital: el tiempo, los planes, la
    movilidad, las noticias que te afectan, las farmacias de guardia, la gasolina y el aceite.
  </p>

  {edicion && contenido ? (
    <>
      <h2>Así fue la edición del {longDate(edicion.data.fecha)}</h2>
      <AccionesEdicion texto={texto} />
      <article class="edicion">
        <contenido.Content />
      </article>
      <p>
        <a href={archivo}>Ver todas las ediciones</a>
      </p>
    </>
  ) : (
    <p class="aviso">Todavía no hay ninguna edición publicada.</p>
  )}
</Base>
