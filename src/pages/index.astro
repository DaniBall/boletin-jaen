---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AccionesEdicion from '../components/AccionesEdicion.astro';
import { ultimaEdicion } from '../lib/ediciones.ts';
import { ciudadActual } from '../../ciudades/index.ts';
import { tagline } from '../../pipeline/config.ts';
import { longDate } from '../../pipeline/lib/fechas.ts';
import { editionUrl } from '../../pipeline/lib/edicion.ts';
import { renderWhatsapp } from '../../pipeline/render/whatsapp.ts';

const ciudad = ciudadActual();
const edicion = await ultimaEdicion();
const contenido = edicion ? await render(edicion) : undefined;
const texto = edicion
  ? renderWhatsapp(edicion.body ?? '', { editionUrl: editionUrl(ciudad, edicion.data.fecha) })
  : '';
---

<Base title={`${ciudad.brand.name} · ${tagline(ciudad.name)}`}>
  <h1>{tagline(ciudad.name)}</h1>
  <p class="meta">
    De lunes a viernes, lo que te cambia el día en {ciudad.name}: el tiempo, los planes, la
    movilidad, las noticias que te afectan, las farmacias de guardia y la gasolina.
  </p>

  {edicion && contenido ? (
    <>
      <h2>Así fue la edición del {longDate(edicion.data.fecha)}</h2>
      <AccionesEdicion texto={texto} />
      <article class="edicion">
        <contenido.Content />
      </article>
      <p>
        <a href="/ediciones/">Ver todas las ediciones</a>
      </p>
    </>
  ) : (
    <p class="aviso">Todavía no hay ninguna edición publicada.</p>
  )}
</Base>
